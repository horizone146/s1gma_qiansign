#!name = 适马小程序自动签到
#!desc = 适马(Sigma)小程序自动签到+转发文章刷积分，每日上限120分可调，token自动捕获。打开小程序后5分钟内自动完成当日任务，含防画像伪装
#!author = horizone146
#!icon = https://simplesat.io/wp-content/uploads/2021/11/Sigma-logo.png
#!tag = 签到,积分
#!type = normal
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!date = 2026-09-26

[Argument]
daily_target = input,"120",tag=每日积分上限,desc=当日获得积分达到该值后停止
max_shares = input,"10",tag=单轮最大转发,desc=每次运行最多转发次数，未达标下轮继续
rest_day = switch,false,tag=随机休息日,desc=约10%的天数自动休息，降低行为画像（会少拿积分）
cron_expr = input,"*/5 * * * *",tag=运行频率,desc=主任务执行周期
enabled = switch,true,tag=启用主任务,desc=关闭后仅捕获token

[Script]
request if ${url} ~= /^https?:\/\/sigmaapi\.mad-sea\.com\/Api\//i then script("https://raw.githubusercontent.com/horizone146/s1gma_qiansign/main/sigma-token.js") with tag="适马Token捕获"

cron ${cron_expr} then script("https://raw.githubusercontent.com/horizone146/s1gma_qiansign/main/sigma-task.js", {${daily_target}, ${max_shares}, ${rest_day}}) with enable=${enabled}, tag="适马每日任务", timeout=600

[MitM]
hostname = sigmaapi.mad-sea.com
