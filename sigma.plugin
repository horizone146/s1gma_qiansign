[Script]
http-request ^https?:\/\/sigmaapi\.mad-sea\.com\/Api\/ script-path=https://raw.githubusercontent.com/horizone146/s1gma_qiansign/main/sigma-token.js, tag=适马Token捕获

[MitM]
hostname = sigmaapi.mad-sea.com
